import requests

# API URL
url = "https://jsonplaceholder.typicode.com/users"

# Fetch data from API
response = requests.get(url)

# Convert JSON response to Python list
users = response.json()

print("\n===== USER DATA FROM API =====\n")

# Display all users
for user in users:
    print(f"ID      : {user['id']}")
    print(f"Name    : {user['name']}")
    print(f"Email   : {user['email']}")
    print(f"City    : {user['address']['city']}")
    print("-" * 35)

# Search Feature
search = input("\nEnter name to search: ").lower()

print("\n===== SEARCH RESULTS =====\n")

found = False

for user in users:

    if search in user['name'].lower():

        found = True

        print(f"ID      : {user['id']}")
        print(f"Name    : {user['name']}")
        print(f"Email   : {user['email']}")
        print(f"City    : {user['address']['city']}")
        print("-" * 35)

if not found:
    print("No user found.")
