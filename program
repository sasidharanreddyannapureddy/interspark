import os
import shutil
from datetime import datetime
def write_log(message):
    with open("logs.txt", "a") as log:
        log.write(f"{datetime.now()} - {message}\n")
def rename_files(folder):
    try:
        files = os.listdir(folder)

        for index, file in enumerate(files):
            old_path = os.path.join(folder, file)

            if os.path.isfile(old_path):
                extension = os.path.splitext(file)[1]
                new_name = f"file_{index+1}{extension}"
                new_path = os.path.join(folder, new_name)

                os.rename(old_path, new_path)

                print(f"Renamed: {file} → {new_name}")
                write_log(f"Renamed {file} to {new_name}")

    except Exception as e:
        print("Error while renaming files:", e)
        write_log(f"Rename Error: {e}")
def sort_files(folder):
    try:
        files = os.listdir(folder)

        for file in files:
            file_path = os.path.join(folder, file)

            if os.path.isfile(file_path):
                extension = file.split(".")[-1]

                target_folder = os.path.join(folder, extension.upper())

                if not os.path.exists(target_folder):
                    os.makedirs(target_folder)

                shutil.move(file_path, os.path.join(target_folder, file))

                print(f"Moved: {file} → {target_folder}")
                write_log(f"Moved {file} to {target_folder}")

    except Exception as e:
        print("Error while sorting files:", e)
        write_log(f"Sort Error: {e}")
def clean_temp_files(folder):
    try:
        files = os.listdir(folder)

        for file in files:
            if file.endswith(".tmp"):
                file_path = os.path.join(folder, file)

                os.remove(file_path)

                print(f"Deleted: {file}")
                write_log(f"Deleted temp file {file}")

    except Exception as e:
        print("Error while cleaning files:", e)
        write_log(f"Clean Error: {e}")
print("=== File Automation Tool ===")
folder_path = input("Enter folder path: ")
print("\n1. Rename Files")
print("2. Sort Files")
print("3. Clean Temp Files")
choice = input("Enter your choice: ")
if choice == "1":
    rename_files(folder_path)

elif choice == "2":
    sort_files(folder_path)

elif choice == "3":
    clean_temp_files(folder_path)

else:
    print("Invalid choice")
